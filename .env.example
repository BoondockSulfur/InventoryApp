# InventoryApp Production Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED SETTINGS
# ============================================

# Secret Key (MUST BE CHANGED!)
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=CHANGE-THIS-TO-A-RANDOM-SECRET-KEY

# Database
POSTGRES_DB=inventoryapp
POSTGRES_USER=inventoryapp
POSTGRES_PASSWORD=CHANGE-THIS-STRONG-PASSWORD

# Redis
REDIS_PASSWORD=CHANGE-THIS-REDIS-PASSWORD

# ============================================
# MAIL CONFIGURATION
# ============================================

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
ADMIN_EMAIL=admin@yourdomain.com

# ============================================
# OPTIONAL SETTINGS
# ============================================

# Ports (default: 80 and 443)
HTTP_PORT=80
HTTPS_PORT=443

# Gunicorn Workers (default: auto)
GUNICORN_WORKERS=4

# Log Level (debug, info, warning, error, critical)
LOG_LEVEL=info

# Dell Warranty Integration (optional)
DELL_CLIENT_ID=
DELL_CLIENT_SECRET=

# Printer Integration (optional)
PRINTER_IP=
PRINTER_PORT=9100

# Backup Configuration
BACKUP_KEEP_DAYS=30

# ============================================
# ELASTICSEARCH SECURITY (Recommended for Production)
# ============================================

# Enable Elasticsearch security (recommended: true)
ELASTICSEARCH_SECURITY_ENABLED=false

# If ELASTICSEARCH_SECURITY_ENABLED=true, set a strong password:
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
ELASTIC_PASSWORD=

# Elasticsearch URL (auto-configured based on security settings)
# If security enabled: http://elastic:${ELASTIC_PASSWORD}@elasticsearch:9200
# If security disabled: http://elasticsearch:9200
ELASTICSEARCH_URL=http://elasticsearch:9200
